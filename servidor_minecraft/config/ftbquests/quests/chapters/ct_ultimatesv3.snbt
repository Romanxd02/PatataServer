	quest_links: [ ]
	quests: [
		{
			description: [
				"La luz solo sirve para proyectar tus verdaderas armas. Domina el flujo de las sombras para almacenar tu arsenal en la oscuridad, convoca la lealtad de tus shikigamis en el momento indicado y no dudes en derramar tu propia energía cuando la batalla exija romper las reglas. Reúne los talismanes para tus rituales, expande un Jardín de la Quimera incompleto pero devastador y demuestra que estás dispuesto a imaginarse una versión más fuerte de ti mismo en lugar de morir en vano. Y si el destino te acorrala, siempre queda la última carta en el abismo: hacer sonar la rueda, convocar al General Divino y arrastrar a cualquiera contigo a la perdición."
				""
				"{image:jujutsucraft:item/icon_mahoragawheel width:50 height:50 align:center}"
			]
			id: "53E583A129C8F3B7"
